<div data-id="widget_circles">
  <Bonfire.UI.Common.WidgetBlockLive
    class="w-full px-card py-3 flex-auto mx-auto overflow-hidden"
    title_class="pb-card text-xs font-semibold uppercase tracking-[0.06em] text-base-content/80"
    widget_title={@widget_title || l("Circles")}
    empty={@circles == []}
    empty_icon="ph:circles-three-duotone"
    empty_message={l("Create a circle to organise people you follow.")}
  >
    <:empty_state>
      <div class="flex flex-col items-center gap-3 py-5 text-center" data-role="widget-empty-state">
        <div
          class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10"
          aria-hidden="true"
        >
          <Iconify.iconify icon="ph:circles-three-duotone" class="h-5 w-5 text-primary" />
        </div>

        <span class="max-w-[36ch] text-sm text-base-content/70">
          {l("Create a circle to organise people you follow.")}
        </span>

        <Bonfire.UI.Common.OpenModalLive
          id="dashboard_new_circle"
          title_text={l("Create a new circle")}
          open_modal_wrapper_class="w-auto h-auto"
          open_btn_wrapper_class="!w-auto min-h-11 rounded-selector btn btn-primary px-5 touch-manipulation"
          no_actions
        >
          <form id="dashboard_new_circle_form" phx-submit="Bonfire.Boundaries.Circles:create">
            <Bonfire.UI.Boundaries.NewCircleLive scope={current_user_id(@__context__)} />
          </form>

          <:open_btn>
            <span>{l("Create a circle")}</span>
          </:open_btn>
        </Bonfire.UI.Common.OpenModalLive>
      </div>
    </:empty_state>

    <nav aria-label={l("Your circles")} data-role="circles-scroll">
      <ul class="flex flex-nowrap gap-2 overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {#for circle <- @circles}
          <li id={"dashboard-circle-#{id(circle)}"} class="shrink-0">
            <LinkLive
              to={~p"/circle/#{id(circle)}"}
              class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full bg-primary/10 py-1 pl-1 pr-3 text-sm font-semibold text-base-content whitespace-nowrap touch-manipulation transition-[background-color,color,transform] duration-150 ease-out hover:-translate-y-px hover:bg-primary/20 hover:text-primary motion-reduce:transform-none motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] active:bg-primary/20"
            >
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-primary text-[0.6875rem] font-extrabold tracking-tight text-primary-content"
                aria-hidden="true"
                data-role="circle-marker"
              >
                {circle_initials(LiveHandler.subject_name(circle))}
              </span>
              {LiveHandler.subject_name(circle)}
            </LinkLive>
          </li>
        {/for}
      </ul>
    </nav>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>
