<div id={@id <> "_component"} class="min-w-0 max-w-full">
  <Dropdown
    id={@id}
    menu={false}
    close_on_select={@mode != :visibility}
    focus_on_open={"#" <> @id <> "_search"}
    position="bottom-start"
    wrapper_class="min-w-0 max-w-full"
    wrapper_opts={["data-boundary": "#composer_container"]}
    trigger_class={"flex h-8 min-w-0 max-w-full items-center gap-1.5 rounded-full border px-3 text-left text-sm font-medium focus-ring " <>
      if @mode == :visibility and
           (not Bonfire.UI.Common.SmartInputLive.public_audience?(@to_boundaries) or @to_circles != [] or
              Bonfire.UI.Common.SmartInputLive.custom_audience?(@exclude_circles, @verb_permissions)),
         do: "border-primary/30 bg-primary/10 text-primary hover:bg-primary/15",
         else: "border-divider bg-base-100 hover:bg-base-200"}
    panel_class="!w-72 max-w-[calc(100vw-2rem)] !p-0"
    trigger_opts={["phx-click": JS.push("load", target: "#" <> @id <> "_component")]}
    label={if @mode == :destination, do: l("Post in"), else: l("Visible to")}
  >
    <:trigger>
      <span class="flex min-w-0 items-center">
        <span class="sr-only">{if @mode == :destination, do: l("Post in"), else: l("Visible to")}</span>
        {#if @context_group && topic_selected?(@context_group)}
          {!-- Group › topic path. When space runs out the group name truncates first (it shrinks 4x faster),
              and on phones only its icon stays, so the topic — the part worth checking — stays readable.
              The full path is in the tooltip and in the menu's section heading. --}
          <span
            class="flex min-w-0 items-center gap-1.5"
            title={"#{@context_group.group_name} › #{@context_group.name}"}
          >
            <#Icon iconify="ph:users-three-duotone" class="size-4 shrink-0 opacity-70" />
            <span
              data-role="destination_group"
              class="min-w-[3ch] max-w-48 shrink-[4] truncate font-normal text-muted max-sm:sr-only"
            >{@context_group.group_name}</span>
            <span aria-hidden="true" class="shrink-0 text-muted max-sm:hidden">›</span>
            <span data-role="destination_topic" class="min-w-[6ch] truncate">{@context_group.name}</span>
          </span>
        {#elseif @context_group}
          <span class="flex min-w-0 items-center gap-1.5">
            <#Icon iconify="ph:users-three-duotone" class="size-4 shrink-0 opacity-70" />
            <span class="min-w-0 truncate">{e(@context_group, :group_name, nil) || @context_group.name}</span>
          </span>
        {#elseif @mode == :destination}
          <span class="flex items-center gap-1.5">
            <#Icon iconify="ph:user-circle-fill" class="size-4 shrink-0 opacity-70" />
            {l("Your profile")}
          </span>
        {#elseif Bonfire.UI.Common.SmartInputLive.custom_audience?(@exclude_circles, @verb_permissions)}
          <span class="flex min-w-0 items-center gap-1.5">
            <Iconify.iconify
              icon={Bonfire.UI.Common.SmartInputLive.group_audience_icon(
                @to_boundaries,
                @exclude_circles,
                @verb_permissions
              )}
              class="size-4 shrink-0 opacity-70"
            />
            {Bonfire.UI.Common.SmartInputLive.group_audience_label(
              @to_boundaries,
              @exclude_circles,
              @verb_permissions
            )}
          </span>
        {#elseif @to_circles != []}
          <span class="flex items-center gap-1.5">
            <#Icon iconify="ph:circles-three" class="size-4 shrink-0 opacity-70" />
            {l("Specific circles")}
          </span>
        {#else}
          <Bonfire.UI.Boundaries.BoundariesPresetNameLive
            to_boundaries={@to_boundaries}
            icon_class="size-4 shrink-0 opacity-70"
          />
        {/if}
      </span>
    </:trigger>

    <div
      class="flex min-h-0 flex-col p-1.5"
      style="max-height: calc(var(--dropdown-available-height, 24rem) - 2px)"
    >
      <.form
        class="shrink-0"
        for={to_form(%{"search" => @search_term})}
        id={@id <> "_search_form"}
        phx-change="search"
        phx-submit="search"
        phx-target={@myself}
      >
        <label for={@id <> "_search"} class="sr-only">
          {if @mode == :destination, do: l("Search joined groups"), else: l("Search audiences")}
        </label>
        <input
          id={@id <> "_search"}
          type="search"
          name="search"
          value={@search_term}
          placeholder={if @mode == :destination, do: l("Search joined groups…"), else: l("Search audiences…")}
          phx-debounce="200"
          class="input input-bordered h-10 w-full text-base focus-ring"
          autocomplete="off"
        />
      </.form>

      <div class="mt-1 min-h-0 flex-1 overflow-y-auto overscroll-contain">
        {#case if @mode == :destination, do: visible_topics(@context_group, @search_term), else: []}
          {#match []}
          {#match topics}
            <div id={@id <> "_topics"} data-role="destination_topics" class="mb-1 border-b border-divider pb-1">
              <p class="px-2 pt-1 pb-1 text-xs text-muted break-words">{l("In %{group}", group: @context_group.group_name)}</p>
              <button
                :if={@search_term == ""}
                type="button"
                data-role="post_in_whole_group"
                phx-click="Bonfire.UI.Common.SmartInput:pick_context"
                phx-value-id={@context_group.group_id}
                phx-target={@event_target || "#smart_input"}
                aria-pressed={"#{not topic_selected?(@context_group)}"}
                class="flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring"
              >
                <#Icon iconify="ph:users-three-duotone" class="size-4 shrink-0 text-primary" />
                {l("Whole group")}
              </button>
              <button
                :for={topic <- topics}
                type="button"
                data-audience-topic={id(topic)}
                phx-click="Bonfire.UI.Common.SmartInput:pick_context"
                phx-value-id={id(topic)}
                phx-target={@event_target || "#smart_input"}
                aria-pressed={"#{@context_group.id == id(topic)}"}
                class="flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector py-1.5 pl-6 pr-2 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring"
              >
                <#Icon iconify="ph:chats-circle-duotone" class="size-4 shrink-0 text-primary" />
                <span class="min-w-0 break-words">{topic_name(topic)}</span>
              </button>
            </div>
        {/case}
        <button
          :if={@mode == :destination}
          type="button"
          data-role="post_in_profile"
          phx-click="Bonfire.UI.Common.SmartInput:select_personal_destination"
          phx-target={@event_target || "#smart_input"}
          aria-pressed={"#{is_nil(@context_group)}"}
          class="flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 focus-ring"
        >
          <#Icon iconify="ph:user-circle-fill" class="size-4 text-primary" />
          {l("Your profile")}
        </button>
        <p :if={@mode == :destination} class="px-2 py-1 text-xs text-muted">{l("Who can see the post depends on its visibility.")}</p>

        <p :if={@options != []} class="px-2 py-1 text-xs text-muted">{l("Audiences")}</p>
        <button
          :for={{audience_id, meta} <- @options}
          type="button"
          data-audience-preset={audience_id}
          aria-pressed={"#{Bonfire.UI.Boundaries.GeneralAccessListLive.matches?(@to_boundaries, audience_id)}"}
          phx-click="Bonfire.UI.Common.SmartInput:select_audience"
          phx-value-id={audience_id}
          phx-target={@event_target || "#smart_input"}
          class="flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring"
        >
          <Iconify.iconify
            icon={e(meta, :icon, nil) || "ph:users-duotone"}
            class="size-4 shrink-0 text-primary"
          />
          <span class="min-w-0 break-words">{e(meta, :label, nil) || e(meta, :name, nil)}</span>
        </button>

        <p :if={@circles != []} class="px-2 pt-2 pb-1 text-xs text-muted">{l("Your circles · can see and participate")}</p>
        <button
          :for={circle <- @circles}
          type="button"
          data-audience-circle={circle.id}
          aria-pressed={"#{circle_selected?(@to_circles, circle.id)}"}
          phx-click="Bonfire.UI.Common.SmartInput:toggle_audience_circle"
          phx-value-id={circle.id}
          phx-target={@event_target || "#smart_input"}
          class="group flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring"
        >
          <#Icon iconify="ph:circles-three" class="size-4 shrink-0 text-primary" />
          <span class="min-w-0 grow break-words">{e(circle, :named, :name, "")}</span>
          <#Icon iconify="ph:check" class="size-4 invisible group-aria-pressed:visible" />
        </button>

        <p :if={@groups != []} class="px-2 pt-2 pb-1 text-xs text-muted">{l("Joined groups")}</p>
        <button
          :for={group <- @groups}
          type="button"
          data-audience-group={group.id}
          aria-pressed={"#{e(@context_group, :group_id, nil) == group.id}"}
          phx-click="Bonfire.UI.Common.SmartInput:select_audience_group"
          phx-value-id={group.id}
          phx-target={@event_target || "#smart_input"}
          class="flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring"
        >
          <#Icon iconify="ph:users-three-duotone" class="size-4 shrink-0 text-primary" />
          <span class="min-w-0 break-words">{group.name}</span>
        </button>

        <p
          :if={@audiences != nil and @options == [] and @groups == [] and @circles == []}
          role="status"
          class="p-3 text-sm text-muted"
        >
          {if @mode == :destination, do: l("No matching joined groups"), else: l("No matching audiences")}
        </p>
        <p :if={@more_groups?} class="p-2 text-xs text-muted">{l("Keep typing to narrow the group results.")}</p>
      </div>

      <div :if={slot_assigned?(:default)} class="mt-1 shrink-0 border-t border-divider pt-1">
        <#slot />
      </div>
    </div>
  </Dropdown>
</div>
