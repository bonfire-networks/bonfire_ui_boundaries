<Dropdown
  id={@id}
  menu={false}
  close_on_select
  wrapper_class="w-full"
  position="bottom-start"
  trigger_class="btn btn-outline border-hair border-secondary w-full justify-between font-normal"
  panel_class="!w-full max-h-[50vh] overflow-y-auto flex flex-col gap-0.5 p-1.5"
  label={l("Choose who can see and interact with this")}
>
  <:trigger>
    {#case selected_option(@boundary_preset, @to_boundaries, @my_acls, @presets)}
      {#match {label, icon}}
        <span class="flex items-center gap-2 min-w-0">
          <Iconify.iconify icon={icon} class="w-5 h-5 text-primary flex-shrink-0" />
          <span class="truncate">{label}</span>
        </span>
    {/case}
    <#Icon iconify="ph:caret-down-bold" class="w-4 h-4 flex-shrink-0" />
  </:trigger>

  {#if !@hide_presets}
    {#for slug <-
        @presets ||
          Bonfire.Common.Config.get(:preset_order, ["public", "local", "mentions"], :bonfire_boundaries)}
      <button
        data-scope={"#{slug}_boundary"}
        class={
          "w-full flex items-center gap-3 px-2.5 py-2 rounded-field text-left cursor-pointer text-base-content transition-colors duration-150 hover:bg-base-200",
          "bg-base-200": matches?(@boundary_preset, slug)
        }
        aria-pressed={"#{matches?(@boundary_preset, slug)}"}
        phx-click={@set_action ||
          JS.push("Bonfire.Boundaries:replace_boundary",
            value: %{id: slug, name: e(Bonfire.Boundaries.Presets.for_preset(slug), :label, slug)},
            target: "#customize_boundary_live"
          )}
        phx-value-id={slug}
        phx-value-name={e(Bonfire.Boundaries.Presets.for_preset(slug), :label, slug)}
        type="button"
        {...@set_opts}
      >
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-base-content/5">
          <Iconify.iconify
            icon={e(Bonfire.Boundaries.Presets.for_preset(slug), :icon, "ph:gear-six-duotone")}
            class="size-5"
          />
        </span>
        <span class="flex min-w-0 flex-1 flex-col">
          <span class="text-sm font-medium">
            {e(Bonfire.Boundaries.Presets.for_preset(slug), :label, slug)}
          </span>
          <span class="text-xs text-muted break-words line-clamp-2">
            {e(Bonfire.Boundaries.Presets.for_preset(slug), :description, nil)}
          </span>
        </span>
        {#if matches?(@boundary_preset, slug)}
          <#Icon iconify="ph:check-bold" class="w-4 h-4 text-primary flex-shrink-0" />
        {/if}
      </button>
    {/for}
  {/if}

  {!-- Custom ACLs --}
  {#for {acl_id, acl} <- @my_acls}
    <button
      data-role="custom_boundary"
      class={
        "w-full flex items-center gap-3 px-2.5 py-2 rounded-field text-left cursor-pointer text-base-content transition-colors duration-150 hover:bg-base-200",
        "bg-base-200": matches?(@to_boundaries, @boundary_preset, acl_id)
      }
      aria-pressed={"#{matches?(@to_boundaries, @boundary_preset, acl_id)}"}
      phx-click={@set_action ||
        JS.push("Bonfire.Boundaries:replace_boundary",
          value: %{id: acl_id, name: e(acl, :name, nil)},
          target: "#customize_boundary_live"
        )}
      phx-value-id={acl_id}
      phx-value-name={e(acl, :name, nil)}
      type="button"
      {...@set_opts}
    >
      <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-base-content/5">
        {#case e(acl, :icon, nil)}
          {#match nil}
            <#Icon iconify="fluent:door-tag-20-filled" class="size-5" />
          {#match icon}
            <Iconify.iconify icon={icon} class="size-5" />
        {/case}
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="text-sm font-medium">{e(acl, :name, nil)}</span>
        <span class="text-xs text-muted break-words line-clamp-2">{e(acl, :description, nil)}</span>
      </span>
      {#if matches?(@to_boundaries, @boundary_preset, acl_id)}
        <#Icon iconify="ph:check-bold" class="w-4 h-4 text-primary flex-shrink-0" />
      {/if}
    </button>
  {/for}

  {#if !@hide_custom}
    <button
      data-id="custom_boundary"
      class={
        "w-full flex items-center gap-3 px-2.5 py-2 rounded-field text-left cursor-pointer text-base-content transition-colors duration-150 hover:bg-base-200",
        "bg-base-200": matches?(@boundary_preset, "custom")
      }
      aria-pressed={"#{matches?(@boundary_preset, "custom")}"}
      phx-click={@set_action ||
        JS.push("Bonfire.Boundaries:replace_boundary",
          value: %{id: "custom", name: l("Custom")},
          target: "#customize_boundary_live"
        )}
      type="button"
    >
      <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-base-content/5">
        <#Icon iconify="ri:settings-4-line" class="size-5" />
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="text-sm font-medium">{l("Custom")}</span>
        <span class="text-xs text-muted break-words line-clamp-2">{l("Start from scratch.")}</span>
      </span>
      {#if matches?(@boundary_preset, "custom")}
        <#Icon iconify="ph:check-bold" class="w-4 h-4 text-primary flex-shrink-0" />
      {/if}
    </button>
  {/if}

  {#if !@hide_private}
    <button
      class={
        "w-full flex items-center gap-3 px-2.5 py-2 rounded-field text-left cursor-pointer text-base-content transition-colors duration-150 hover:bg-base-200",
        "bg-base-200": matches?(@boundary_preset, "private")
      }
      aria-pressed={"#{matches?(@boundary_preset, "private")}"}
      phx-click={@set_action ||
        JS.push("Bonfire.Boundaries:replace_boundary",
          value: %{
            id: "private",
            name: e(Bonfire.Boundaries.Presets.for_preset("private"), :label, l("Private"))
          },
          target: "#customize_boundary_live"
        )}
      phx-value-id="private"
      phx-value-name={e(Bonfire.Boundaries.Presets.for_preset("private"), :label, l("Private"))}
      type="button"
      {...@set_opts}
    >
      <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-base-content/5">
        <Iconify.iconify
          icon={e(Bonfire.Boundaries.Presets.for_preset("private"), :icon, "heroicons-solid:eye-off")}
          class="size-5"
        />
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="text-sm font-medium">
          {e(Bonfire.Boundaries.Presets.for_preset("private"), :label, l("Private"))}
        </span>
        <span class="text-xs text-muted break-words line-clamp-2">
          {e(Bonfire.Boundaries.Presets.for_preset("private"), :description, nil)}
        </span>
      </span>
      {#if matches?(@boundary_preset, "private")}
        <#Icon iconify="ph:check-bold" class="w-4 h-4 text-primary flex-shrink-0" />
      {/if}
    </button>
  {/if}
</Dropdown>
