<div class="flex flex-col gap-4">
  <div
    :if={@state.locked?}
    data-role="permissions_locked_notice"
    id={@parent_id <> "_permissions_locked_notice"}
    class="flex items-start gap-2 rounded-lg bg-base-content/5 p-3 text-sm text-muted"
  >
    <#Icon iconify="ph:lock-simple-duotone" class="size-5 shrink-0 text-primary" />
    <p>{l(
        "This audience controls access through its recipients, so these quick controls are unavailable. An off switch here does not mean recipients cannot read the post."
      )}</p>
  </div>
  <p :if={@read_only} class="text-sm text-muted">{l("These permissions are read-only.")}</p>

  {#for {section_key, title, actions} <- sections(@state.action_states)}
    <section
      data-role={"permission_#{section_key}"}
      aria-labelledby={@parent_id <> "_" <> section_key}
    >
      <h3 id={@parent_id <> "_" <> section_key} class="mb-2 text-sm font-semibold">{title}</h3>
      <p :if={section_key == "reading"} class="mb-2 text-sm text-muted">
        {l("Changing reading permissions changes who can access this post.")}
      </p>
      <div class="flex flex-col divide-y divide-base-content/10 rounded-xl border border-base-content/10 overflow-hidden">
        <div :for={action_state <- actions} class="flex flex-col">
          <label class="flex items-center gap-3 p-2 cursor-pointer has-disabled:cursor-default">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <Iconify.iconify icon={action_state.icon} class="size-5" />
            </span>
            <span class="flex-1 min-w-0 text-sm font-medium text-base-content">
              {action_state.label}
            </span>

            <input
              type="checkbox"
              class="toggle toggle-primary toggle-sm shrink-0 focus-ring"
              id={@parent_id <> "_action_" <> action_state.key}
              aria-describedby={if @state.locked?, do: @parent_id <> "_permissions_locked_notice"}
              data-role={"action_toggle_#{action_state.key}"}
              checked={action_state.allowed?}
              phx-click={JS.push("toggle_action_allowed",
                value: %{
                  "action" => action_state.key,
                  "allowed" => !action_state.allowed?
                },
                target: "##{@parent_id}"
              )}
              disabled={@read_only || action_state.locked?}
            />
          </label>

          {!-- reveals the exceptions without touching the toggle (eg. quotes, off by default with nothing changed) --}
          <button
            :if={action_state.offers_exceptions? and not action_state.show_exceptions?}
            type="button"
            data-role={"action_exceptions_toggle_#{action_state.key}"}
            class="p-2 text-right text-sm text-primary border-t border-secondary hover:bg-base-content/5"
            phx-click={JS.push("reveal_action_exceptions",
              value: %{"action" => action_state.key},
              target: "##{@parent_id}"
            )}
          >
            {l("Allow for some people")}
          </button>

          <div
            :if={action_state.show_exceptions?}
            data-role={"action_exceptions_#{action_state.key}"}
            class="flex flex-col gap-2 p-3 border-t border-secondary bg-base-content/5"
          >
            <p class="text-sm font-medium">{l("Allow exceptions")}</p>
            <p class="text-xs text-muted">
              {l(
                "People in the selected circles can still perform this action when it is off for the general audience."
              )}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 max-h-48 overflow-y-auto pr-1">
              {#for circle <- @state.exception_circles}
                <label class="flex min-h-11 items-center gap-2 text-sm cursor-pointer min-w-0">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-sm checkbox-primary flex-shrink-0"
                    data-role={"action_exception_#{action_state.key}_#{uid(circle)}"}
                    checked={Map.get(action_state.exception_checks, uid(circle), false)}
                    phx-click={JS.push("toggle_action_exception",
                      value: %{"action" => action_state.key, "circle_id" => uid(circle)},
                      target: "##{@parent_id}"
                    )}
                    disabled={@read_only || action_state.locked?}
                  />
                  <span class="break-words">{circle_name(circle)}</span>
                </label>
              {/for}
            </div>
          </div>
        </div>
      </div>
    </section>
  {/for}
</div>
