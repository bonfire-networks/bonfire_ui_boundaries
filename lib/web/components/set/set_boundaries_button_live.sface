{#case clone_context(@to_boundaries)}
  {#match false}
    <Bonfire.UI.Boundaries.AudiencePickerLive
      id="composer_visibility_picker"
      mode={:visibility}
      to_boundaries={@to_boundaries}
      to_circles={@to_circles}
      exclude_circles={@exclude_circles}
      verb_permissions={@verb_permissions}
      event_target={@event_target}
    >
      <Bonfire.UI.Boundaries.CustomBoundaryButtonLive
        boundary_preset={@boundary_preset}
        to_circles={@to_circles}
        exclude_circles={@exclude_circles}
        to_boundaries={@to_boundaries}
        verb_permissions={@verb_permissions}
        setting_boundaries={@setting_boundaries}
      />
    </Bonfire.UI.Boundaries.AudiencePickerLive>
  {#match boundary_name}
    {#if e(@context_group, :topics, []) != [] and @context_group}
      <Dropdown
        id="set_boundaries_topic_dropdown"
        position="bottom-start"
        trigger_class="btn-primary btn btn-sm gap-1"
        panel_class="flex-col flex-nowrap max-h-60 overflow-y-auto"
        label={l("Choose a topic in this group")}
        wrapper_opts={["data-tip": l("Choose a topic in this group")]}
      >
        <:trigger>
          <span class="truncate max-w-[10rem]">{boundary_name}</span>
          <#Icon iconify="carbon:chevron-down" class="size-4" />
        </:trigger>
        <li>
          <button
            type="button"
            data-role="select-topic"
            class={
              "flex items-center gap-2 w-full text-left",
              "font-medium": @context_id == e(@context_group, :id, nil)
            }
            :on-click={Bonfire.UI.Common.SmartInput.LiveHandler.open(%JS{}, %{
              context_id: e(@context_group, :id, nil),
              mentions: e(@context_group, :mentions, []),
              to_boundaries: e(@context_group, :to_boundaries, nil),
              to_circles: e(@context_group, :to_circles, [])
            })}
            phx-target={@event_target || "#smart_input"}
          >
            <#Icon iconify="ph:users-three-duotone" class="w-4 h-4 text-muted" />
            <span class="truncate">{l("Whole group")}</span>
          </button>
        </li>
        <li class="menu-title pt-2 pb-1 text-xs uppercase opacity-60">{l("Topics")}</li>
        {#for topic <- e(@context_group, :topics, [])}
          <li>
            <button
              type="button"
              data-role="select-topic"
              class={
                "flex items-center gap-2 w-full text-left",
                "font-medium": @context_id == id(topic)
              }
              :on-click={Bonfire.UI.Common.SmartInput.LiveHandler.open(%JS{}, %{
                context_id: id(topic),
                mentions: [id(topic)],
                to_boundaries: [{:clone_context, topic_name(topic)}],
                to_circles: [{id(topic), topic_name(topic)}]
              })}
              phx-target={@event_target || "#smart_input"}
            >
              <#Icon iconify="ph:hash-duotone" class="w-4 h-4 text-muted" />
              <span class="truncate">{topic_name(topic)}</span>
            </button>
          </li>
        {/for}
      </Dropdown>
    {#else}
      <div class="btn-active btn btn-ghost btn-sm cursor-default">
        <span>{boundary_name}</span>
      </div>
    {/if}
{/case}
