<ul role="navigation" class={@class}>
  <li>
    <LinkLive
      to={~p"/settings/boundaries/circles"}
      class={
        " ",
        "bg-fill-strong ": @selected_tab == "circles"
      }
    >
      <span class="">{l("Circles")}</span>
    </LinkLive>
  </li>

  <li>
    <LinkLive
      to={~p"/settings/boundaries/roles"}
      class={
        " ",
        "bg-fill-strong ": @selected_tab == "roles"
      }
    >
      <span class="">{l("Roles")}</span>
    </LinkLive>
  </li>

  <li>
    <LinkLive
      to={~p"/settings/instance/boundaries/roles"}
      class={
        " ",
        "bg-fill-strong ": @selected_tab == "roles"
      }
    >
      {!-- <#Icon
        iconify="mingcute:hat-fill"
        class={
          "size-5 font-normal text-muted",
          "size-6 ml-2 text-info/70": @showing_within == :dashboard
        }
      /> --}
      <div class="flex flex-col">
        <span class={
          "text-sm",
          "font-medium": @showing_within == :dashboard
        }>{l("Default roles")}</span>
        {!-- <p class="text-sm text-muted" :if={@showing_within == :dashboard}>{l("Define sets of permissions which you can assign to users and circles")}</p> --}
      </div>
    </LinkLive>
  </li>

  <li>
    <LinkLive
      to={~p"/settings/boundaries/acls"}
      class={
        " ",
        "bg-fill-strong ": @selected_tab == "acls"
      }
    >
      <span class="">{l("Boundary Presets")}</span>
    </LinkLive>
  </li>
</ul>
